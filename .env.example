# Django
# Create separate, strong values before any non-local deployment.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Existing PostgreSQL (this compose file never creates, resets, or migrates it).
# For Docker on this machine use host.docker.internal; for a remote DB use its hostname.
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=replace-with-your-existing-password
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_URL=postgres://your_database_user:replace-with-your-existing-password@host.docker.internal:5432/your_database_name

# JWT
JWT_SECRET=replace-with-a-different-long-random-secret

# Storage
MEDIA_ROOT=media/
MEDIA_URL=/media/
MEDIA_STORAGE=local # or s3
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payment (placeholder)
PAYMENT_PROVIDER=dummy
PAYMENT_KEY=
PAYMENT_SECRET=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (baked into the Vite build)
VITE_API_BASE=http://localhost:8000/api/v1
